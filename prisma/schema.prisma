generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Profession {
  student
  developer
  designer
  other
}

model Member {
  id              Int      @id @default(autoincrement())
  first_name      String
  last_name       String
  email           String   @unique
  password        String
  profession      Profession
  createdAt       DateTime @default(now())
}